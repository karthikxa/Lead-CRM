# Zed Render 512MB optimized — single web service runs UI + API + cron (no separate worker)
# PINNED to v2.37.0 (Aug 27 2026) — last version working on Render free tier.
# Do NOT change to :latest — newer versions need more RAM.
FROM twentycrm/twenty:v2.37.0

# Confirmed working config from deploy dep-dadah9afngtc738hl8vg (commit bb28cfa).
# --optimize_for_size: reduces V8 per-object overhead ~15%, critical for 512MB limit.
# 450MB heap leaves ~62MB for OS/native overhead.
# NODE_OPTIONS env var in Render dashboard must NOT be set (it would override this).
ENV NODE_OPTIONS="--max-old-space-size=450 --optimize_for_size"
ENV NODE_ENV=production
ENV DISABLE_DB_MIGRATIONS=true
ENV DISABLE_CRON_JOBS_REGISTRATION=true
ENV PATCH_FRONT_ASSETS=false
ENV PORT=10000
ENV NODE_PORT=10000

USER root
# patch-branding.sh patches main.js to inject early port binding + close-handoff before NestJS starts
COPY branding/patch-branding.sh /app/patch-branding.sh
# Lead finder UI only (no backend scraper)
COPY lead_finder_ui.js /app/packages/twenty-server/dist/front/lead_finder_ui.js

EXPOSE 10000

# IMPORTANT: No --require flag here. patch-branding.sh injects early port binding
# directly into dist/main.js with a proper close-and-handoff before NestJS binds.
# Adding --require here causes EADDRINUSE crash (two servers on same port).
ENTRYPOINT ["/bin/sh", "-c", "sh /app/patch-branding.sh; exec /app/entrypoint.sh node --optimize_for_size dist/main"]
