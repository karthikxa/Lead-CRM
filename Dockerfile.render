# Zed Render 512MB optimized — single web service, ultra-low memory footprint
FROM twentycrm/twenty:latest

# Do NOT set a global NODE_OPTIONS heap cap — it applies to every node subprocess
# (patch script, proxy, etc.) and causes OOM before NestJS even starts.
# Heap limit is set ONLY on the NestJS exec in ENTRYPOINT below.
ENV MALLOC_ARENA_MAX=2
ENV UV_THREADPOOL_SIZE=2
ENV NODE_ENV=production
ENV DISABLE_DB_MIGRATIONS=true
ENV DISABLE_CRON_JOBS_REGISTRATION=true
# Disable heavy optional providers — our workflow worker handles emails/calendar externally.
# These providers load massive Google API SDKs that consume 80-120MB of heap.
ENV DISABLE_MESSAGING_PROVIDER=true
ENV DISABLE_CALENDAR_PROVIDER=true
ENV IS_MESSAGING_ENABLED=false
ENV IS_CALENDAR_ENABLED=false
ENV AUTH_GOOGLE_ENABLED=true
ENV MESSAGING_PROVIDER_GMAIL_ENABLED=false
ENV CALENDAR_PROVIDER_GOOGLE_ENABLED=false
ENV TELEMETRY_ENABLED=false
ENV TELEMETRY_ANONYMIZATION_ENABLED=false
ENV DISABLE_BILLING=true
ENV IS_BILLING_ENABLED=false
ENV IS_AI_ENABLED=false
ENV PORT=3000
ENV NODE_PORT=3000
ENV REDIS_URL=redis://127.0.0.1:6379
ENV REDIS_QUEUE_URL=redis://127.0.0.1:6379
ENV CACHE_STORAGE_TYPE=redis

USER root
# Install ultra-lightweight in-container Redis (~4MB RAM)
RUN apk add --no-cache redis

# Copy branding and workflow scripts into image
COPY branding/patch-branding.sh /app/patch-branding.sh
COPY scripts/agency-workflow-worker.js /app/scripts/agency-workflow-worker.js
COPY scripts/zed-luxury-email.js /app/scripts/zed-luxury-email.js

EXPOSE 3000
# ENTRYPOINT strategy:
# 1. Run patch-branding.sh sequentially — patch files and start proxy daemon on PUBLIC port
# 2. Exec NestJS on internal port 3001 as foreground PID 1
#    --jitless              → disables V8 JIT compiler, saves 60-100MB RAM (critical for 512MB tier)
#    --max-old-space-size=512 → NestJS heap limit (avoids premature Mark-Compact aborts near 385MB)
#    --optimize-for-size    → V8 picks smaller bytecode paths
#    --expose-gc            → allow manual GC triggers
ENTRYPOINT ["/bin/sh", "-c", "sh /app/patch-branding.sh; PORT=3001 NODE_PORT=3001 exec /app/entrypoint.sh node --jitless --max-old-space-size=512 --optimize-for-size --expose-gc dist/main"]

