# Zed Render 512MB optimized — single web service runs UI + API + cron (no separate worker)
FROM twentycrm/twenty:latest

# 512MB Render Free: limit heap to 300MB (leaves ~212MB for OS/native/PG client overhead)
ENV NODE_OPTIONS="--max-old-space-size=460 --optimize_for_size"
ENV NODE_ENV=production
ENV DISABLE_DB_MIGRATIONS=true
ENV DISABLE_CRON_JOBS_REGISTRATION=true
ENV PORT=3000
ENV NODE_PORT=3000

USER root
# patch-branding + providers are bind-mounted in docker-compose, but for Render we COPY them into image
COPY branding/patch-branding.sh /app/patch-branding.sh
COPY lead_scraper_service.js /app/packages/twenty-server/dist/lead_scraper_service.js
COPY lead_finder_ui.js /app/packages/twenty-server/dist/front/lead_finder_ui.js
COPY lead_scraper_providers /app/packages/twenty-server/dist/lead_scraper_providers

# Render expects PORT env, Twenty uses NODE_PORT
EXPOSE 3000
ENTRYPOINT ["/bin/sh", "-c", "sh /app/patch-branding.sh; exec /app/entrypoint.sh node dist/main"]
