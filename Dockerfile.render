# Zed Render 512MB optimized — single web service, ultra-low memory footprint
FROM twentycrm/twenty:latest

# NOTE: --expose-gc must be a NODE arg, NOT in NODE_OPTIONS (Render strips it).
# We pass it directly via ENTRYPOINT below. NODE_OPTIONS only gets heap limit.
ENV NODE_OPTIONS="--max-old-space-size=380"
ENV MALLOC_ARENA_MAX=2
ENV UV_THREADPOOL_SIZE=2
ENV NODE_ENV=production
ENV DISABLE_DB_MIGRATIONS=true
ENV DISABLE_CRON_JOBS_REGISTRATION=true
# Enable messaging and calendar providers
ENV DISABLE_MESSAGING_PROVIDER=false
ENV DISABLE_CALENDAR_PROVIDER=false
ENV IS_MESSAGING_ENABLED=true
ENV IS_CALENDAR_ENABLED=true
ENV AUTH_GOOGLE_ENABLED=true
ENV MESSAGING_PROVIDER_GMAIL_ENABLED=true
ENV CALENDAR_PROVIDER_GOOGLE_ENABLED=true
ENV TELEMETRY_ENABLED=false
ENV TELEMETRY_ANONYMIZATION_ENABLED=false
ENV DISABLE_BILLING=true
ENV IS_BILLING_ENABLED=false
ENV IS_AI_ENABLED=false
ENV PORT=3000
ENV NODE_PORT=3000
ENV REDIS_URL=redis://127.0.0.1:6379
ENV REDIS_QUEUE_URL=redis://127.0.0.1:6379
ENV CACHE_STORAGE_TYPE=redis

USER root
# Install ultra-lightweight in-container Redis (~4MB RAM)
RUN apk add --no-cache redis

# Copy branding and workflow scripts into image
COPY branding/patch-branding.sh /app/patch-branding.sh
COPY scripts/agency-workflow-worker.js /app/scripts/agency-workflow-worker.js

EXPOSE 3000
# ENTRYPOINT strategy:
# 1. Run patch-branding.sh sequentially to patch files and start proxy daemon on PUBLIC port
# 2. Exec NestJS on internal port 3001 in foreground as PID 1
ENTRYPOINT ["/bin/sh", "-c", "sh /app/patch-branding.sh; PORT=3001 NODE_PORT=3001 exec /app/entrypoint.sh node --expose-gc dist/main"]

