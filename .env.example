# Zed CRM - Production .env.example
# Copy to .env and fill. For Daytona, set SERVER_URL to your preview URL.

TAG=latest
PORT=3000

# Database (Daytona uses internal network - keep as db/redis)
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=CHANGE_ME_strong_password_without_special_chars
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default
REDIS_URL=redis://redis:6379

# Public URL - CRITICAL for Gmail OAuth + teammates
# Local: http://localhost:3000
# Daytona: https://<workspace-id>-3000.preview.daytona.io  (Ports tab → 3000 → Public)
# Production domain: https://zed.yourdomain.com
SERVER_URL=http://localhost:3000

# Secrets - generate with: openssl rand -base64 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32
APP_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# Storage
STORAGE_TYPE=local
# For production S3:
# STORAGE_TYPE=S_3
# STORAGE_S3_REGION=eu-west-3
# STORAGE_S3_NAME=zed-bucket
# STORAGE_S3_ENDPOINT=https://s3.amazonaws.com
# STORAGE_S3_ACCESS_KEY_ID=...
# STORAGE_S3_SECRET_ACCESS_KEY=...

# === GOOGLE GMAIL SSO - each teammate logs in with Gmail ===
# 1. Create project at https://console.cloud.google.com
# 2. Enable Gmail API + People API + Calendar API
# 3. OAuth consent screen → External → Add scopes: openid, email, profile
# 4. Credentials → Create OAuth Client ID (Web) → Add redirect URIs:
#    ${SERVER_URL}/auth/google/callback
#    ${SERVER_URL}/auth/google-apis/callback
# 5. Paste ID/Secret below
MESSAGING_PROVIDER_GMAIL_ENABLED=true
CALENDAR_PROVIDER_GOOGLE_ENABLED=true
AUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTH_GOOGLE_CALLBACK_URL=${SERVER_URL}/auth/google/callback
AUTH_GOOGLE_APIS_CALLBACK_URL=${SERVER_URL}/auth/google-apis/callback

# Optional: restrict signup to Google only, set password login off via Admin Panel later

# === Email sending (for invites + workflow emails) ===
# Use Gmail App Password or Sendgrid/Postmark
EMAIL_FROM_ADDRESS=noreply@zed.yourdomain.com
EMAIL_FROM_NAME=Zed
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
